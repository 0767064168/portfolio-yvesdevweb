PORT=3000
APP_URL=http://localhost:3000

# Sécurité des sessions (En production, générez une clé aléatoire forte : `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=remplacez_avec_une_chaine_secrete_aleatoire_tres_longue
COOKIE_SECURE=false

# Supabase (Obligatoire pour persister la base de données en production)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete
